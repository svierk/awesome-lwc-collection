<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Take User Profile Picture</masterLabel>
    <description>Create a photo using the device's camera and use it to update the user profile.</description>
    <targets>
      <target>lightning__AppPage</target>
      <target>lightning__FlowScreen</target>
      <target>lightning__HomePage</target>
      <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
      <targetConfig targets="lightning__AppPage,lightning__FlowScreen,lightning__HomePage,lightning__RecordPage">
        <property
        name="defaultCamera"
        type="String"
        label="Default Camera"
        description="The camera to start with, front or back. Devices with only one camera use that one."
        datasource="front,back"
        default="front"
      />
      </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
